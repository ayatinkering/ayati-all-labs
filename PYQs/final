PART 7 — Write the cryptographic helper functions

You should always create these first if relevant.

SHA
def sha256_hash(data):
    return hashlib.sha256(data).hexdigest()
Timestamp
def get_timestamp():
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")
DES encrypt
def des_encrypt(data, key, iv):
    cipher = DES.new(key, DES.MODE_CBC, iv)
    return cipher.encrypt(pad(data, DES.block_size))
DES decrypt
def des_decrypt(encrypted, key, iv):
    cipher = DES.new(key, DES.MODE_CBC, iv)
    return unpad(
        cipher.decrypt(encrypted),
        DES.block_size
    )
RSA keys
def generate_rsa_keys():
    private_key = RSA.generate(2048)
    public_key = private_key.publickey()
    return private_key, public_key
Signature
def sign_data(data, private_key):
    h = SHA256.new(data)
    return pkcs1_15.new(private_key).sign(h)
Verify
def verify_signature(data, signature, public_key):
    h = SHA256.new(data)

    try:
        pkcs1_15.new(public_key).verify(h, signature)
        return True
    except:
        return False

These are your building blocks.

